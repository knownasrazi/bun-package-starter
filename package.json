{
  "name": "bun-package-starter",
  "version": "1.0.0",
  "description": "Scaffold a publishable Bun + TypeScript npm package with one command. tsup, Biome and CI included.",
  "keywords": [
    "bun",
    "typescript",
    "package",
    "starter",
    "scaffold",
    "boilerplate",
    "create",
    "tsup",
    "npm"
  ],
  "license": "MIT",
  "author": {
    "name": "Razi",
    "url": "https://github.com/knownasrazi"
  },
  "type": "module",
  "bin": {
    "create-bun-package": "./dist/cli.js"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "template"
  ],
  "engines": {
    "node": ">=18",
    "bun": ">=1.0"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "biome check --diagnostic-level=warn .",
    "format": "biome format --write .",
    "release": "bun run lint && bun run typecheck && bun run build && bun test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@types/bun": "^1.2.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.0"
  }
}
